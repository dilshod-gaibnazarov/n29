/// email/phone GLOBAL unique — bu platform darajasidagi identity. Tenant ichidagi telefon unikalligi students/parents/employees jadvallarida alohida.
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String?    @unique @db.VarChar
  phone              String?    @unique @db.VarChar
  passwordHash       String     @map("password_hash")
  status             UserStatus @default(PENDING)
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEncrypted String?    @map("mfa_secret_encrypted")
  mfaEnrolledAt      DateTime?  @map("mfa_enrolled_at") @db.Timestamptz
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz
  phoneVerifiedAt    DateTime?  @map("phone_verified_at") @db.Timestamptz
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @default(now()) @map("updated_at") @db.Timestamptz

  userMfaRecoveryCodes       UserMfaRecoveryCode[]
  userSessions               UserSession[]
  platformUserRolesUser      PlatformUserRole[]          @relation("platform_user_roles_user")
  platformUserRolesGrantedBy PlatformUserRole[]          @relation("platform_user_roles_granted_by")
  organizationMemberships    OrganizationMembership[]
  membershipRoleAssignments  MembershipRoleAssignment[]
  files                      File[]
  employees                  Employee[]
  payrollPeriods             PayrollPeriod[]
  leadActivities             LeadActivity[]
  leadTasks                  LeadTask[]
  students                   Student[]
  studentStatusHistory       StudentStatusHistory[]
  parents                    Parent[]
  studentGroupTransfers      StudentGroupTransfer[]
  lessonSessions             LessonSession[]
  attendances                Attendance[]
  assignments                Assignment[]
  assignmentSubmissions      AssignmentSubmission[]
  studentLedgerEntries       StudentLedgerEntry[]
  invoices                   Invoice[]
  payments                   Payment[]
  refunds                    Refund[]
  discountAssignments        DiscountAssignment[]
  otherIncomes               OtherIncome[]
  expenses                   Expense[]
  cashboxTransfers           CashboxTransfer[]
  financialPeriods           FinancialPeriod[]
  subscriptionPlanChanges    SubscriptionPlanChange[]
  platformWalletTransactions PlatformWalletTransaction[]
  notifications              Notification[]
  telegramUserLinks          TelegramUserLink[]
  reportJobs                 ReportJob[]
  auditLogs                  AuditLog[]

  @@map("users")
}

model UserMfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, codeHash])
  @@map("user_mfa_recovery_codes")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceName       String?   @map("device_name") @db.VarChar
  ipAddress        String?   @map("ip_address") @db.VarChar
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model PlatformUserRole {
  userId    String   @map("user_id") @db.Uuid
  roleCode  String   @map("role_code") @db.VarChar
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user          User  @relation("platform_user_roles_user", fields: [userId], references: [id])
  grantedByUser User? @relation("platform_user_roles_granted_by", fields: [grantedBy], references: [id])

  @@id([userId, roleCode])
  @@map("platform_user_roles")
}

/// V2.0 + : organizations/cashboxes/plans/salary_schemes valyutalari farq qilishi mumkin. Konvertatsiya kursi shu yerdan olinadi va tranzaksiya paytida snapshot qilinadi.
model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  String   @map("base_currency") @db.VarChar(3)
  quoteCurrency String   @map("quote_currency") @db.VarChar(3)
  rate          Decimal  @db.Decimal(18, 8)
  validFrom     DateTime @map("valid_from") @db.Date
  source        String?  @db.VarChar
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([baseCurrency, quoteCurrency, validFrom])
  @@map("exchange_rates")
}

model Organization {
  id         String             @id @default(uuid()) @db.Uuid
  name       String             @db.VarChar
  slug       String             @unique @db.VarChar
  logoFileId String?            @map("logo_file_id") @db.Uuid
  status     OrganizationStatus @default(TRIAL)
  timezone   String             @default("Asia/Tashkent") @db.VarChar
  currency   String             @default("UZS") @db.VarChar(3)
  language   String             @default("uz") @db.VarChar(5)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime           @default(now()) @map("updated_at") @db.Timestamptz

  logoFile File? @relation("organizations_logo_file", fields: [logoFileId], references: [id])

  organizationSetting           OrganizationSetting?
  branches                      Branch[]
  organizationMemberships       OrganizationMembership[]
  roles                         Role[]
  filesOrganization             File[]                         @relation("files_organization")
  employees                     Employee[]
  salarySchemes                 SalaryScheme[]
  payrollPeriods                PayrollPeriod[]
  leadSources                   LeadSource[]
  leadPipelines                 LeadPipeline[]
  leadLostReasons               LeadLostReason[]
  leads                         Lead[]
  students                      Student[]
  parents                       Parent[]
  courseCategories              CourseCategory[]
  courses                       Course[]
  holidays                      Holiday[]
  discounts                     Discount[]
  paymentProviderAccounts       PaymentProviderAccount[]
  cashboxes                     Cashbox[]
  financeCategories             FinanceCategory[]
  financialPeriods              FinancialPeriod[]
  subscription                  Subscription?
  subscriptionPlanChanges       SubscriptionPlanChange[]
  platformWallet                PlatformWallet?
  platformWalletTransactions    PlatformWalletTransaction[]
  subscriptionCharges           SubscriptionCharge[]
  platformPayments              PlatformPayment[]
  communicationProviderAccounts CommunicationProviderAccount[]
  notificationTemplates         NotificationTemplate[]
  notifications                 Notification[]
  reportJobs                    ReportJob[]
  outboxEvents                  OutboxEvent[]
  idempotencyKeys               IdempotencyKey[]
  auditLogs                     AuditLog[]

  @@map("organizations")
}

/// V2.0 + TZ 1.5 "settings, branding". 1:1 organizations bilan.
model OrganizationSetting {
  organizationId String   @id @default(uuid()) @map("organization_id") @db.Uuid
  primaryColor   String?  @map("primary_color") @db.VarChar(7)
  supportEmail   String?  @map("support_email") @db.VarChar
  supportPhone   String?  @map("support_phone") @db.VarChar
  invoicePrefix  String?  @map("invoice_prefix") @db.VarChar
  settings       Json     @default(dbgenerated("'{}'")) @db.JsonB
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_settings")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar
  address        String?
  phone          String?      @db.VarChar
  timezone       String?      @db.VarChar
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  membershipRoleAssignments MembershipRoleAssignment[]
  rooms                     Room[]
  employeeBranchAssignments EmployeeBranchAssignment[]
  leads                     Lead[]
  trialLessons              TrialLesson[]
  groups                    Group[]
  holidays                  Holiday[]
  payments                  Payment[]
  cashboxBranchScopes       CashboxBranchScope[]
  otherIncomes              OtherIncome[]
  expenses                  Expense[]
  auditLogs                 AuditLog[]

  @@unique([organizationId, name])
  @@unique([organizationId, id], map: "branches_tenant_uq")
  @@index([organizationId, status])
  @@map("branches")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime         @map("joined_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  membershipRoleAssignments MembershipRoleAssignment[]
  notificationPreferences   NotificationPreference[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id], map: "memberships_tenant_uq")
  @@index([userId, status])
  @@map("organization_memberships")
}

/// V2.0: (organization_id, code) uchun partial unique index qo'shildi — SQL ilovaga qarang. v1.0 da code ustunida hech qanday constraint yo'q edi.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar
  code           String?  @db.VarChar
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  rolePermissions           RolePermission[]
  membershipRoleAssignments MembershipRoleAssignment[]

  @@unique([organizationId, name])
  @@unique([organizationId, id], map: "roles_tenant_uq")
  @@map("roles")
}

model RolePermission {
  organizationId String          @map("organization_id") @db.Uuid
  roleId         String          @map("role_id") @db.Uuid
  permissionCode String          @map("permission_code") @db.VarChar
  scope          PermissionScope
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  role Role @relation(fields: [organizationId, roleId], references: [organizationId, id])

  @@id([roleId, permissionCode])
  @@index([organizationId, roleId])
  @@map("role_permissions")
}

/// 5NF: irreducible ternary grant fact (membership, role, branch-scope). Bir foydalanuvchi F1 da BRANCH_MANAGER, F2 da TEACHER bo'lishi mumkin — kombinatsiyalar mustaqil emas, shuning uchun ajratilmaydi (4NF tekshiruvidan o'tgan). V2.0: organization_id qo'shildi va membership/role/branch uchtasi ham co
model MembershipRoleAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  grantedBy      String?  @map("granted_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  membership    OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id])
  role          Role                   @relation(fields: [organizationId, roleId], references: [organizationId, id])
  branch        Branch?                @relation(fields: [organizationId, branchId], references: [organizationId, id])
  grantedByUser User?                  @relation(fields: [grantedBy], references: [id])

  @@index([organizationId, membershipId])
  @@index([organizationId, roleId])
  @@map("membership_role_assignments")
}

model Room {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  branchId       String     @map("branch_id") @db.Uuid
  name           String     @db.VarChar
  capacity       Int?
  status         RoomStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @default(now()) @map("updated_at") @db.Timestamptz

  branch Branch @relation(fields: [organizationId, branchId], references: [organizationId, id])

  schedules      Schedule[]
  lessonSessions LessonSession[]

  @@unique([branchId, name])
  @@unique([organizationId, id], map: "rooms_tenant_uq")
  @@map("rooms")
}

/// Plan storage limiti SUM(size_bytes) WHERE deleted_at IS NULL orqali hisoblanadi.
model File {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  storageKey     String    @unique @map("storage_key") @db.VarChar
  name           String    @db.VarChar
  mimeType       String    @map("mime_type") @db.VarChar
  sizeBytes      BigInt    @map("size_bytes")
  uploadedBy     String?   @map("uploaded_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  organization   Organization? @relation("files_organization", fields: [organizationId], references: [id])
  uploadedByUser User?         @relation(fields: [uploadedBy], references: [id])

  organizationsLogoFile Organization[]   @relation("organizations_logo_file")
  courseMaterials       CourseMaterial[]
  certificates          Certificate[]
  assignmentFiles       AssignmentFile[]
  submissionFiles       SubmissionFile[]
  reportJobs            ReportJob[]

  @@unique([organizationId, id], map: "files_tenant_uq")
  @@index([organizationId, createdAt])
  @@map("files")
}

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  fullName       String         @map("full_name") @db.VarChar
  phone          String?        @db.VarChar
  email          String?        @db.VarChar
  position       String?        @db.VarChar
  status         EmployeeStatus @default(ACTIVE)
  hireDate       DateTime?      @map("hire_date") @db.Date
  terminatedAt   DateTime?      @map("terminated_at") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  employeeBranchAssignments EmployeeBranchAssignment[]
  employeeSalaryAssignments EmployeeSalaryAssignment[]
  payrollItems              PayrollItem[]
  leads                     Lead[]
  groupTeachers             GroupTeacher[]

  @@unique([organizationId, phone], map: "employees_org_phone_uq")
  @@unique([organizationId, id], map: "employees_tenant_uq")
  @@index([organizationId, status])
  @@map("employees")
}

/// V2.0: unique constraint qo'shildi (v1.0 da yo'q edi — bitta xodimni bitta filialga cheksiz marta biriktirish mumkin edi). is_primary uchun partial unique — SQL ilovaga qarang.
model EmployeeBranchAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  isPrimary      Boolean   @default(false) @map("is_primary")
  startsAt       DateTime? @map("starts_at") @db.Date
  endsAt         DateTime? @map("ends_at") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id])
  branch   Branch   @relation(fields: [organizationId, branchId], references: [organizationId, id])

  @@unique([employeeId, branchId, startsAt])
  @@index([organizationId, branchId])
  @@map("employee_branch_assignments")
}

model SalaryScheme {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  name           String             @db.VarChar
  status         SalarySchemeStatus @default(DRAFT)
  currency       String             @db.VarChar(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  salaryRules               SalaryRule[]
  employeeSalaryAssignments EmployeeSalaryAssignment[]

  @@unique([organizationId, name])
  @@unique([organizationId, id], map: "salary_schemes_tenant_uq")
  @@map("salary_schemes")
}

/// V2.0 + TZ 1.11: `type` ustuni qo'shildi. v1.0 da faqat `expression` bor edi, ya'ni 8 ta rule turining hammasi DSL'ga aylanardi va UI typed rule builder chizolmasdi. CHECK: type ga qarab qaysi ustun majburiy — SQL ilovaga qarang.
model SalaryRule {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  schemeId       String         @map("scheme_id") @db.Uuid
  name           String         @db.VarChar
  type           SalaryRuleType
  priority       Int
  baseAmount     Decimal?       @map("base_amount") @db.Decimal(18, 2)
  percentage     Decimal?       @db.Decimal(9, 4)
  expression     String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz

  scheme SalaryScheme @relation(fields: [organizationId, schemeId], references: [organizationId, id])

