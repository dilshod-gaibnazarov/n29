  category      FinanceCategory @relation(fields: [organizationId, categoryId], references: [organizationId, id])
  createdByUser User            @relation(fields: [createdBy], references: [id])

  @@index([organizationId, occurredAt])
  @@index([organizationId, cashboxId, occurredAt])
  @@index([organizationId, categoryId])
  @@map("expenses")
}

/// CHECK (from_cashbox_id <> to_cashbox_id) — SQL ilovada. v1.0 da kassadan o'ziga o'tkazma qilish mumkin edi.
model CashboxTransfer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fromCashboxId  String   @map("from_cashbox_id") @db.Uuid
  toCashboxId    String   @map("to_cashbox_id") @db.Uuid
  amount         Decimal  @db.Decimal(18, 2)
  currency       String   @db.VarChar(3)
  exchangeRate   Decimal? @map("exchange_rate") @db.Decimal(18, 8)
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  fromCashbox   Cashbox @relation("cashbox_transfers_from_cashbox", fields: [organizationId, fromCashboxId], references: [organizationId, id])
  toCashbox     Cashbox @relation("cashbox_transfers_to_cashbox", fields: [organizationId, toCashboxId], references: [organizationId, id])
  createdByUser User    @relation(fields: [createdBy], references: [id])

  @@index([organizationId, occurredAt])
  @@map("cashbox_transfers")
}

/// V2.0: unique qo'shildi — v1.0 da umuman yo'q edi (payroll_periods da bor edi — izchilsizlik). BCNF: determinant (organization_id, period_start). Overlap taqiqi SQL ilovada.
model FinancialPeriod {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  periodStart    DateTime              @map("period_start") @db.Date
  periodEnd      DateTime              @map("period_end") @db.Date
  status         FinancialPeriodStatus @default(OPEN)
  closedAt       DateTime?             @map("closed_at") @db.Timestamptz
  closedBy       String?               @map("closed_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  closedByUser User?        @relation(fields: [closedBy], references: [id])

  @@unique([organizationId, periodStart], map: "financial_periods_org_start_uq")
  @@map("financial_periods")
}

/// Platform-level — organization_id YO'Q (ongli). TZ 1.10: narx hardcode qilinmaydi.
model Plan {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar
  code         String     @unique @db.VarChar
  monthlyPrice Decimal    @map("monthly_price") @db.Decimal(18, 2)
  currency     String     @db.VarChar(3)
  status       PlanStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz

  planFeatures                    PlanFeature[]
  subscriptions                   Subscription[]
  subscriptionPlanChangesFromPlan SubscriptionPlanChange[] @relation("subscription_plan_changes_from_plan")
  subscriptionPlanChangesToPlan   SubscriptionPlanChange[] @relation("subscription_plan_changes_to_plan")
  subscriptionCharges             SubscriptionCharge[]

  @@map("plans")
}

/// EAV emas, aniq chegaralangan kalitlar to'plami. 5NF: limit_value (plan, feature) juftligining fakti. V2.0: TZ 1.10 dagi limitlarga SMS kvotasi qo'shildi (audit P2 #28).
model PlanFeature {
  planId     String   @map("plan_id") @db.Uuid
  featureKey String   @map("feature_key") @db.VarChar
  limitValue Decimal? @map("limit_value") @db.Decimal(18, 4)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  plan Plan @relation(fields: [planId], references: [id])

  @@id([planId, featureKey])
  @@map("plan_features")
}

/// Bir org = bitta joriy subscription. Tarix subscription_plan_changes da (V2.0 +).
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @unique @map("organization_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  gracePeriodDays    Int                @default(7) @map("grace_period_days")
  startedAt          DateTime           @map("started_at") @db.Timestamptz
  currentPeriodStart DateTime           @map("current_period_start") @db.Date
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Date
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])

  subscriptionPlanChanges SubscriptionPlanChange[]
  subscriptionCharges     SubscriptionCharge[]

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// V2.0 + TZ 1.10: v1.0 da subscriptions.organization_id unique edi va plan upgrade/downgrade tarixi butunlay yo'qolardi. MRR o'sishini hisoblash imkonsiz edi.
model SubscriptionPlanChange {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  fromPlanId     String?  @map("from_plan_id") @db.Uuid
  toPlanId       String   @map("to_plan_id") @db.Uuid
  reason         String?
  changedBy      String?  @map("changed_by") @db.Uuid
  effectiveFrom  DateTime @map("effective_from") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscription  Subscription @relation(fields: [subscriptionId], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id])
  fromPlan      Plan?        @relation("subscription_plan_changes_from_plan", fields: [fromPlanId], references: [id])
  toPlan        Plan         @relation("subscription_plan_changes_to_plan", fields: [toPlanId], references: [id])
  changedByUser User?        @relation(fields: [changedBy], references: [id])

  @@unique([subscriptionId, effectiveFrom])
  @@index([organizationId, effectiveFrom])
  @@map("subscription_plan_changes")
}

model PlatformWallet {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @map("organization_id") @db.Uuid
  currency       String       @db.VarChar(3)
  balanceCached  Decimal      @default(0) @map("balance_cached") @db.Decimal(18, 2)
  status         WalletStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  platformWalletTransactions PlatformWalletTransaction[]
  platformPayments           PlatformPayment[]

  @@map("platform_wallets")
}

/// IMMUTABLE LEDGER — TZ 1.10. UPDATE/DELETE taqiqlanadi.
model PlatformWalletTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  walletId       String                @map("wallet_id") @db.Uuid
  type           WalletTransactionType
  direction      LedgerDirection
  amount         Decimal               @db.Decimal(18, 2)
  description    String?
  occurredAt     DateTime              @map("occurred_at") @db.Timestamptz
  createdBy      String?               @map("created_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz

  wallet        PlatformWallet @relation(fields: [walletId], references: [id])
  organization  Organization   @relation(fields: [organizationId], references: [id])
  createdByUser User?          @relation(fields: [createdBy], references: [id])

  subscriptionCharge SubscriptionCharge?
  platformPayment    PlatformPayment?

  @@index([walletId, occurredAt])
  @@index([organizationId, type, occurredAt])
  @@map("platform_wallet_transactions")
}

/// V2.0 BCNF tuzatishi: unique (subscription_id, period_start, period_end) → (subscription_id, period_start). period_start → period_end (oylik davr), shuning uchun eski kalit bir davrni ikki xil oxir sanasi bilan yozishga ruxsat berardi.
model SubscriptionCharge {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  subscriptionId String                   @map("subscription_id") @db.Uuid
  planId         String                   @map("plan_id") @db.Uuid
  periodStart    DateTime                 @map("period_start") @db.Date
  periodEnd      DateTime                 @map("period_end") @db.Date
  amount         Decimal                  @db.Decimal(18, 2)
  currency       String                   @db.VarChar(3)
  status         SubscriptionChargeStatus @default(PENDING)
  walletTxId     String?                  @unique @map("wallet_tx_id") @db.Uuid
  failureReason  String?                  @map("failure_reason")
  chargedAt      DateTime?                @map("charged_at") @db.Timestamptz
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  subscription Subscription               @relation(fields: [subscriptionId], references: [id])
  organization Organization               @relation(fields: [organizationId], references: [id])
  plan         Plan                       @relation(fields: [planId], references: [id])
  walletTx     PlatformWalletTransaction? @relation(fields: [walletTxId], references: [id])

  @@unique([subscriptionId, periodStart], map: "subscription_charges_period_uq")
  @@index([organizationId, status, periodStart])
  @@map("subscription_charges")
}

/// Organization → Platform wallet top-up (TZ 1.10).
model PlatformPayment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  walletId       String        @map("wallet_id") @db.Uuid
  walletTxId     String?       @unique @map("wallet_tx_id") @db.Uuid
  amount         Decimal       @db.Decimal(18, 2)
  currency       String        @db.VarChar(3)
  method         PaymentMethod
  providerTxId   String?       @map("provider_tx_id") @db.VarChar
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  wallet       PlatformWallet             @relation(fields: [walletId], references: [id])
  organization Organization               @relation(fields: [organizationId], references: [id])
  walletTx     PlatformWalletTransaction? @relation(fields: [walletTxId], references: [id])

  @@index([organizationId, paidAt])
  @@map("platform_payments")
}

/// V2.0: (organization_id, id, channel) unique — notification_deliveries.channel ni composite FK bilan qulflash uchun.
model CommunicationProviderAccount {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  channel              NotificationChannel
  provider             String                @db.VarChar
  credentialsEncrypted String                @map("credentials_encrypted")
  status               ProviderAccountStatus @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  notificationDeliveries NotificationDelivery[]
  telegramUserLinks      TelegramUserLink[]

  @@unique([organizationId, channel, provider])
  @@unique([organizationId, id], map: "cpa_tenant_uq")
  @@unique([organizationId, id, channel], map: "cpa_channel_uq")
  @@map("communication_provider_accounts")
}

/// 5NF: body — (org, event, channel, language) to'rtligining fakti, ajratilmaydi.
model NotificationTemplate {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  eventKey       String              @map("event_key") @db.VarChar
  channel        NotificationChannel
  language       String              @db.VarChar(5)
  subject        String?             @db.VarChar
  body           String
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, eventKey, channel, language])
  @@map("notification_templates")
}

/// 5NF: enabled — (membership, event, channel) uchligining fakti. Ajratilsa "qaysi event uchun qaysi kanal yoqilgan" ma'lumoti yo'qoladi.
model NotificationPreference {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  membershipId   String              @map("membership_id") @db.Uuid
  eventKey       String              @map("event_key") @db.VarChar
  channel        NotificationChannel
  enabled        Boolean             @default(true)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @default(now()) @map("updated_at") @db.Timestamptz

  membership OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id])

  @@unique([membershipId, eventKey, channel])
  @@index([organizationId, membershipId])
  @@map("notification_preferences")
}

model Notification {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  eventKey         String    @map("event_key") @db.VarChar
  recipientUserId  String?   @map("recipient_user_id") @db.Uuid
  recipientAddress String?   @map("recipient_address") @db.VarChar
  payload          Json      @db.JsonB
  scheduledAt      DateTime? @map("scheduled_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization  Organization @relation(fields: [organizationId], references: [id])
  recipientUser User?        @relation(fields: [recipientUserId], references: [id])

  notificationDeliveries NotificationDelivery[]

  @@unique([organizationId, id], map: "notifications_tenant_uq")
  @@index([organizationId, eventKey, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([scheduledAt])
  @@map("notifications")
}

/// V2.0 3NF tuzatishi: v1.0 da channel ustuni provider_account_id orqali tranzitiv aniqlanardi (delivery → provider_account → channel) va ikkisi bir-biriga zid bo'lishi mumkin edi. Endi composite FK (organization_id, provider_account_id, channel) → communication_provider_accounts(organization_id, id, c
model NotificationDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  notificationId    String              @map("notification_id") @db.Uuid
  channel           NotificationChannel
  providerAccountId String?             @map("provider_account_id") @db.Uuid
  providerMessageId String?             @map("provider_message_id") @db.VarChar
  status            DeliveryStatus      @default(PENDING)
  attempts          Int                 @default(0)
  lastError         String?             @map("last_error")
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamptz
  readAt            DateTime?           @map("read_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @default(now()) @map("updated_at") @db.Timestamptz

  notification                        Notification                  @relation(fields: [organizationId, notificationId], references: [organizationId, id])
  channelCommunicationProviderAccount CommunicationProviderAccount? @relation(fields: [organizationId, providerAccountId, channel], references: [organizationId, id, channel])

  @@unique([notificationId, channel])
  @@index([organizationId, status, createdAt])
  @@map("notification_deliveries")
}

model TelegramUserLink {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  providerAccountId String    @map("provider_account_id") @db.Uuid
  telegramChatId    String    @map("telegram_chat_id") @db.VarChar
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user            User                         @relation(fields: [userId], references: [id])
  providerAccount CommunicationProviderAccount @relation(fields: [organizationId, providerAccountId], references: [organizationId, id])

  @@unique([userId, providerAccountId])
  @@unique([providerAccountId, telegramChatId])
  @@map("telegram_user_links")
}

/// TZ 1.13: katta XLSX/PDF sinxron HTTP ichida generatsiya qilinmaydi.
model ReportJob {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String?         @map("organization_id") @db.Uuid
  requestedBy    String          @map("requested_by") @db.Uuid
  reportType     String          @map("report_type") @db.VarChar
  filters        Json            @db.JsonB
  status         ReportJobStatus @default(QUEUED)
  fileId         String?         @map("file_id") @db.Uuid
  errorMessage   String?         @map("error_message")
  expiresAt      DateTime?       @map("expires_at") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz

  organization    Organization? @relation(fields: [organizationId], references: [id])
  requestedByUser User          @relation(fields: [requestedBy], references: [id])
  file            File?         @relation(fields: [organizationId, fileId], references: [organizationId, id])

  @@index([organizationId, status, createdAt])
  @@index([expiresAt])
  @@map("report_jobs")
}

/// TZ 2.4 Transactional Outbox. KRITIK: publisher uchun partial index MAJBURIY — CREATE INDEX ... ON outbox_events (occurred_at) WHERE published_at IS NULL. Usiz worker har safar butun jadvalni skanerlaydi va jadval o'sgani sari sekinlashadi (v1.0 da hech qanday index yo'q edi).
model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  topic          String    @db.VarChar
  version        Int
  aggregateType  String    @map("aggregate_type") @db.VarChar
  aggregateId    String    @map("aggregate_id") @db.Uuid
  payload        Json      @db.JsonB
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([aggregateType, aggregateId, occurredAt])
  @@index([topic, occurredAt])
  @@map("outbox_events")
}

/// V2.0 KRITIK TUZATISH: v1.0 da hech qanday unique index YO'Q edi. Jadvalning butun mazmuni — takrorlanishni DB darajasida bloklash. Usiz ikkita parallel so'rov ikkalasi ham "yangi kalit" deb hisoblanardi va IKKI MARTA TO'LOV yozilardi (TZ 1.9 "idempotency, duplicate protection majburiy").
model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  scope          String   @db.VarChar
  key            String   @db.VarChar
  requestHash    String?  @map("request_hash") @db.VarChar
  responseCode   Int?     @map("response_code")
  responseBody   Json?    @map("response_body") @db.JsonB
  expiresAt      DateTime @map("expires_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([scope, key], map: "idempotency_scope_key_uq")
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Immutable. TZ 2.6: sensitive payload mask qilinadi — password/token/card secret YOZILMAYDI.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar
  entityType     String   @map("entity_type") @db.VarChar
  entityId       String?  @map("entity_id") @db.Uuid
  oldValue       Json?    @map("old_value") @db.JsonB
  newValue       Json?    @map("new_value") @db.JsonB
  requestId      String?  @map("request_id") @db.VarChar
  ipAddress      String?  @map("ip_address") @db.VarChar
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id])
  branch       Branch?       @relation(fields: [organizationId, branchId], references: [organizationId, id])
  actorUser    User?         @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, actorUserId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}
