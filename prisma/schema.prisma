generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SUPERADMIN
  ADMIN
  SELLER
  CUSTOMER
}

enum Status {
  ACTIVE
  INACTIVE
}

model User {
  id             Int      @id @default(autoincrement())
  phone          String   @unique
  hashedPassword String
  status         Status   @default(ACTIVE)
  role           Roles
  fullName       String?
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}