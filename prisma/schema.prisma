  startDate       DateTime    @map("start_date") @db.Date
  expectedEndDate DateTime?   @map("expected_end_date") @db.Date
  maxStudents     Int?        @map("max_students")
  status          GroupStatus @default(PLANNED)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz

  branch        Branch        @relation(fields: [organizationId, branchId], references: [organizationId, id])
  courseVersion CourseVersion @relation(fields: [organizationId, courseVersionId], references: [organizationId, id])

  trialLessons     TrialLesson[]
  groupTeachers    GroupTeacher[]
  groupEnrollments GroupEnrollment[]
  schedules        Schedule[]
  lessonSessions   LessonSession[]
  assignments      Assignment[]

  @@unique([organizationId, branchId, name])
  @@unique([organizationId, id], map: "groups_tenant_uq")
  @@unique([organizationId, branchId, id], map: "groups_branch_uq")
  @@index([organizationId, status])
  @@index([organizationId, branchId, status])
  @@map("groups")
}

/// V2.0: unique qo'shildi — v1.0 da bitta o'qituvchini bir guruhga cheksiz marta biriktirish mumkin edi. Bir guruhda bir vaqtda bitta MAIN — partial unique SQL ilovada.
model GroupTeacher {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  groupId        String           @map("group_id") @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  role           GroupTeacherRole @default(MAIN)
  startsAt       DateTime?        @map("starts_at") @db.Date
  endsAt         DateTime?        @map("ends_at") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  group    Group    @relation(fields: [organizationId, groupId], references: [organizationId, id])
  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id])

  @@unique([groupId, employeeId, role, startsAt], map: "group_teachers_uq")
  @@index([organizationId, employeeId])
  @@map("group_teachers")
}

/// V2.0: (organization_id, group_id, id) unique — attendances va assignment_submissions uchun composite FK maqsadi (guruh mosligini trigger'siz majburlaydi).
model GroupEnrollment {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  groupId        String           @map("group_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  joinedAt       DateTime         @map("joined_at") @db.Date
  leftAt         DateTime?        @map("left_at") @db.Date
  status         EnrollmentStatus @default(ACTIVE)
  priceOverride  Decimal?         @map("price_override") @db.Decimal(18, 2)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz

  group   Group   @relation(fields: [organizationId, groupId], references: [organizationId, id])
  student Student @relation(fields: [organizationId, studentId], references: [organizationId, id])

  studentGroupTransfersFromEnrollment StudentGroupTransfer[] @relation("student_group_transfers_from_enrollment")
  studentGroupTransfersToEnrollment   StudentGroupTransfer[] @relation("student_group_transfers_to_enrollment")
  attendances                         Attendance[]
  certificates                        Certificate[]
  assignmentSubmissions               AssignmentSubmission[]
  studentPaymentPlans                 StudentPaymentPlan[]
  discountAssignments                 DiscountAssignment[]

  @@unique([groupId, studentId])
  @@unique([organizationId, id], map: "group_enrollments_tenant_uq")
  @@unique([organizationId, groupId, id], map: "group_enrollments_group_uq")
  @@index([organizationId, studentId, status])
  @@index([organizationId, groupId, status])
  @@map("group_enrollments")
}

/// V2.0 + TZ 1.7 "transfer history". v1.0 da guruhdan guruhga o'tish izi yo'q edi — student_status_history faqat freeze/graduation ni qamrab olardi.
model StudentGroupTransfer {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  studentId        String   @map("student_id") @db.Uuid
  fromEnrollmentId String   @map("from_enrollment_id") @db.Uuid
  toEnrollmentId   String   @map("to_enrollment_id") @db.Uuid
  reason           String?
  transferredAt    DateTime @map("transferred_at") @db.Timestamptz
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  student        Student         @relation(fields: [organizationId, studentId], references: [organizationId, id])
  fromEnrollment GroupEnrollment @relation("student_group_transfers_from_enrollment", fields: [organizationId, fromEnrollmentId], references: [organizationId, id])
  toEnrollment   GroupEnrollment @relation("student_group_transfers_to_enrollment", fields: [organizationId, toEnrollmentId], references: [organizationId, id])
  createdByUser  User?           @relation(fields: [createdBy], references: [id])

  @@unique([fromEnrollmentId, toEnrollmentId])
  @@index([organizationId, studentId, transferredAt])
  @@map("student_group_transfers")
}

/// V2.0 + TZ 3.11: `lesson.generate` job'i recurring schedule'dan LessonSession yaratadi. Bu jadval bo'lmasa generator bayram kunlariga ham dars yaratadi. branch_id NULL bo'lganda PostgreSQL unique index NULL'larni to'qnashtirmaydi — partial unique variant SQL ilovada.
model Holiday {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  name           String   @db.VarChar
  date           DateTime @db.Date
  isWorkingDay   Boolean  @default(false) @map("is_working_day")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [organizationId, branchId], references: [organizationId, id])

  @@unique([organizationId, branchId, date])
  @@map("holidays")
}

/// weekday + local time — organization/branch timezone bo'yicha talqin qilinadi. CHECK: start_time < end_time, weekday BETWEEN 1 AND 7 — SQL ilovada.
model Schedule {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  groupId        String    @map("group_id") @db.Uuid
  roomId         String?   @map("room_id") @db.Uuid
  weekday        Int
  startTime      DateTime  @map("start_time") @db.Time
  endTime        DateTime  @map("end_time") @db.Time
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  group Group @relation(fields: [organizationId, groupId], references: [organizationId, id])
  room  Room? @relation(fields: [organizationId, roomId], references: [organizationId, id])

  lessonSessions LessonSession[]

  @@unique([organizationId, id], map: "schedules_tenant_uq")
  @@index([organizationId, groupId, effectiveFrom])
  @@index([roomId, weekday])
  @@map("schedules")
}

/// Xona va o'qituvchi konflikti (TZ 1.8) EXCLUDE USING gist bilan tekshiriladi — SQL ilovaga qarang. CHECK: starts_at < ends_at.
model LessonSession {
  id                       String              @id @default(uuid()) @db.Uuid
  organizationId           String              @map("organization_id") @db.Uuid
  groupId                  String              @map("group_id") @db.Uuid
  scheduleId               String?             @map("schedule_id") @db.Uuid
  roomId                   String?             @map("room_id") @db.Uuid
  topicId                  String?             @map("topic_id") @db.Uuid
  startsAt                 DateTime            @map("starts_at") @db.Timestamptz
  endsAt                   DateTime            @map("ends_at") @db.Timestamptz
  status                   LessonSessionStatus @default(PLANNED)
  rescheduledFromSessionId String?             @map("rescheduled_from_session_id") @db.Uuid
  cancelReason             String?             @map("cancel_reason")
  cancelledBy              String?             @map("cancelled_by") @db.Uuid
  cancelledAt              DateTime?           @map("cancelled_at") @db.Timestamptz
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime            @default(now()) @map("updated_at") @db.Timestamptz

  group                  Group            @relation(fields: [organizationId, groupId], references: [organizationId, id])
  schedule               Schedule?        @relation(fields: [organizationId, scheduleId], references: [organizationId, id])
  room                   Room?            @relation(fields: [organizationId, roomId], references: [organizationId, id])
  topic                  CurriculumTopic? @relation(fields: [organizationId, topicId], references: [organizationId, id])
  rescheduledFromSession LessonSession?   @relation("lesson_sessions_rescheduled_from_session", fields: [organizationId, rescheduledFromSessionId], references: [organizationId, id])
  cancelledByUser        User?            @relation(fields: [cancelledBy], references: [id])

  rescheduledToSession LessonSession[] @relation("lesson_sessions_rescheduled_from_session")
  attendances          Attendance[]

  @@unique([organizationId, id], map: "lesson_sessions_tenant_uq")
  @@unique([organizationId, groupId, id], map: "lesson_sessions_group_uq")
  @@unique([rescheduledFromSessionId], map: "lesson_sessions_reschedule_uq")
  @@index([organizationId, groupId, startsAt])
  @@index([organizationId, startsAt])
  @@index([roomId, startsAt])
  @@map("lesson_sessions")
}

/// V2.0: v1.0 dagi "enrollment group must equal lesson session group; enforce with constraint trigger" izohi endi TRIGGER EMAS — group_id ustuni + 2 ta composite FK buni deklarativ majburlaydi.
model Attendance {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  groupId           String           @map("group_id") @db.Uuid
  lessonSessionId   String           @map("lesson_session_id") @db.Uuid
  groupEnrollmentId String           @map("group_enrollment_id") @db.Uuid
  status            AttendanceStatus
  arrivalTime       DateTime?        @map("arrival_time") @db.Timestamptz
  comment           String?
  markedBy          String?          @map("marked_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @default(now()) @map("updated_at") @db.Timestamptz

  lessonSession   LessonSession   @relation(fields: [organizationId, groupId, lessonSessionId], references: [organizationId, groupId, id])
  groupEnrollment GroupEnrollment @relation(fields: [organizationId, groupId, groupEnrollmentId], references: [organizationId, groupId, id])
  markedByUser    User?           @relation(fields: [markedBy], references: [id])

  @@unique([lessonSessionId, groupEnrollmentId])
  @@index([organizationId, groupEnrollmentId])
  @@index([organizationId, status, createdAt])
  @@map("attendances")
}

/// V2.0 + TZ 2.2: certificate_no GLOBAL unique edi → tenant-aware qilindi. Aks holda A markazi 001-raqamni olsa, B markazi ololmasdi.
model Certificate {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  groupEnrollmentId String   @map("group_enrollment_id") @db.Uuid
  fileId            String?  @map("file_id") @db.Uuid
  certificateNo     String   @map("certificate_no") @db.VarChar
  issuedAt          DateTime @map("issued_at") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  groupEnrollment GroupEnrollment @relation(fields: [organizationId, groupEnrollmentId], references: [organizationId, id])
  file            File?           @relation(fields: [organizationId, fileId], references: [organizationId, id])

  @@unique([organizationId, certificateNo], map: "certificates_org_no_uq")
  @@unique([groupEnrollmentId])
  @@map("certificates")
}

model Assignment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  groupId        String    @map("group_id") @db.Uuid
  topicId        String?   @map("topic_id") @db.Uuid
  title          String    @db.VarChar
  description    String?
  deadline       DateTime? @db.Timestamptz
  maxScore       Decimal?  @map("max_score") @db.Decimal(10, 2)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  group         Group            @relation(fields: [organizationId, groupId], references: [organizationId, id])
  topic         CurriculumTopic? @relation(fields: [organizationId, topicId], references: [organizationId, id])
  createdByUser User             @relation(fields: [createdBy], references: [id])

  assignmentFiles       AssignmentFile[]
  assignmentSubmissions AssignmentSubmission[]

  @@unique([organizationId, id], map: "assignments_tenant_uq")
  @@unique([organizationId, groupId, id], map: "assignments_group_uq")
  @@index([organizationId, groupId, deadline])
  @@map("assignments")
}

model AssignmentFile {
  organizationId String   @map("organization_id") @db.Uuid
  assignmentId   String   @map("assignment_id") @db.Uuid
  fileId         String   @map("file_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  assignment Assignment @relation(fields: [organizationId, assignmentId], references: [organizationId, id])
  file       File       @relation(fields: [organizationId, fileId], references: [organizationId, id])

  @@id([assignmentId, fileId])
  @@map("assignment_files")
}

/// V2.0: v1.0 dagi "enrollment group must equal assignment group" trigger izohi composite FK bilan almashtirildi.
model AssignmentSubmission {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  groupId           String           @map("group_id") @db.Uuid
  assignmentId      String           @map("assignment_id") @db.Uuid
  groupEnrollmentId String           @map("group_enrollment_id") @db.Uuid
  text              String?
  status            SubmissionStatus @default(DRAFT)
  submittedAt       DateTime?        @map("submitted_at") @db.Timestamptz
  score             Decimal?         @db.Decimal(10, 2)
  feedback          String?
  reviewedBy        String?          @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?        @map("reviewed_at") @db.Timestamptz
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @default(now()) @map("updated_at") @db.Timestamptz

  assignment      Assignment      @relation(fields: [organizationId, groupId, assignmentId], references: [organizationId, groupId, id])
  groupEnrollment GroupEnrollment @relation(fields: [organizationId, groupId, groupEnrollmentId], references: [organizationId, groupId, id])
  reviewedByUser  User?           @relation(fields: [reviewedBy], references: [id])

  submissionFiles SubmissionFile[]

  @@unique([assignmentId, groupEnrollmentId])
  @@unique([organizationId, id], map: "submissions_tenant_uq")
  @@index([organizationId, status, submittedAt])
  @@map("assignment_submissions")
}

model SubmissionFile {
  organizationId String   @map("organization_id") @db.Uuid
  submissionId   String   @map("submission_id") @db.Uuid
  fileId         String   @map("file_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  submission AssignmentSubmission @relation(fields: [organizationId, submissionId], references: [organizationId, id])
  file       File                 @relation(fields: [organizationId, fileId], references: [organizationId, id])

  @@id([submissionId, fileId])
  @@map("submission_files")
}

/// V2.0 + TZ 1.9/3.6. Bir student bir nechta valyutada hisobga ega bo'lishi mumkin. Balans SAQLANMAYDI — cache qilinadi; har qanday nomuvofiqlik ledger'dan qayta hisoblanadi (reconciliation job).
model StudentAccount {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  currency        String        @db.VarChar(3)
  status          AccountStatus @default(ACTIVE)
  balanceCached   Decimal       @default(0) @map("balance_cached") @db.Decimal(18, 2)
  balanceCachedAt DateTime?     @map("balance_cached_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  student Student @relation(fields: [organizationId, studentId], references: [organizationId, id])

  studentLedgerEntries StudentLedgerEntry[]
  invoices             Invoice[]
  payments             Payment[]

  @@unique([organizationId, studentId, currency])
  @@unique([organizationId, id], map: "student_accounts_tenant_uq")
  @@index([organizationId, balanceCached])
  @@map("student_accounts")
}

/// APPEND-ONLY. UPDATE va DELETE dastur va DB darajasida taqiqlanadi (TZ 3.5 §7). Balans = SUM(DEBIT) - SUM(CREDIT). Manba hujjat uchun polimorf source_type/source_id EMAS, aniq nullable FK'lar ishlatilgan — FK integriteti saqlanadi.
model StudentLedgerEntry {
  id                   String          @id @default(uuid()) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  accountId            String          @map("account_id") @db.Uuid
  entryType            LedgerEntryType @map("entry_type")
  direction            LedgerDirection
  amount               Decimal         @db.Decimal(18, 2)
  currency             String          @db.VarChar(3)
  invoiceId            String?         @map("invoice_id") @db.Uuid
  paymentId            String?         @map("payment_id") @db.Uuid
  paymentAllocationId  String?         @map("payment_allocation_id") @db.Uuid
  refundId             String?         @map("refund_id") @db.Uuid
  discountAssignmentId String?         @map("discount_assignment_id") @db.Uuid
  reversalOfEntryId    String?         @map("reversal_of_entry_id") @db.Uuid
  description          String?
  createdBy            String?         @map("created_by") @db.Uuid
  occurredAt           DateTime        @map("occurred_at") @db.Timestamptz
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz

  account            StudentAccount      @relation(fields: [organizationId, accountId], references: [organizationId, id])
  invoice            Invoice?            @relation(fields: [organizationId, invoiceId], references: [organizationId, id])
  payment            Payment?            @relation(fields: [organizationId, paymentId], references: [organizationId, id])
  paymentAllocation  PaymentAllocation?  @relation(fields: [paymentAllocationId], references: [id])
  refund             Refund?             @relation(fields: [organizationId, refundId], references: [organizationId, id])
  discountAssignment DiscountAssignment? @relation(fields: [organizationId, discountAssignmentId], references: [organizationId, id])
  reversalOfEntry    StudentLedgerEntry? @relation("student_ledger_entries_reversal_of_entry", fields: [reversalOfEntryId], references: [id])
  createdByUser      User?               @relation(fields: [createdBy], references: [id])

  reversedByEntry StudentLedgerEntry? @relation("student_ledger_entries_reversal_of_entry")

  @@unique([reversalOfEntryId], map: "ledger_reversal_uq")
  @@index([organizationId, accountId, occurredAt])
  @@index([organizationId, entryType, occurredAt])
  @@map("student_ledger_entries")
}

model StudentPaymentPlan {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  groupEnrollmentId String   @map("group_enrollment_id") @db.Uuid
  name              String   @db.VarChar
  totalAmount       Decimal  @map("total_amount") @db.Decimal(18, 2)
  currency          String   @db.VarChar(3)
  status            String   @default("ACTIVE") @db.VarChar
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz

  groupEnrollment GroupEnrollment @relation(fields: [organizationId, groupEnrollmentId], references: [organizationId, id])

  studentPaymentPlanInstallments StudentPaymentPlanInstallment[]

  @@unique([organizationId, id], map: "payment_plans_tenant_uq")
  @@index([groupEnrollmentId])
  @@map("student_payment_plans")
}

model StudentPaymentPlanInstallment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  paymentPlanId  String   @map("payment_plan_id") @db.Uuid
  installmentNo  Int      @map("installment_no")
  dueDate        DateTime @map("due_date") @db.Date
  amount         Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  paymentPlan StudentPaymentPlan @relation(fields: [organizationId, paymentPlanId], references: [organizationId, id])

  invoiceItems InvoiceItem[]

  @@unique([paymentPlanId, installmentNo])
  @@unique([organizationId, id], map: "installments_tenant_uq")
  @@index([organizationId, dueDate])
  @@map("student_payment_plan_installments")
}

/// V2.0 + TZ 2.2: number GLOBAL unique edi → (organization_id, number) ga o'zgartirildi. lifecycle_status FAQAT DRAFT/ISSUED/VOID — PAID/PARTIAL/OVERDUE allocation'lar va sanadan HOSIL QILINADI, saqlanmaydi (v1.0 dagi to'g'ri qaror saqlab qolindi).
model Invoice {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  accountId       String                 @map("account_id") @db.Uuid
  studentId       String                 @map("student_id") @db.Uuid
  number          String                 @db.VarChar
  currency        String                 @db.VarChar(3)
  issueDate       DateTime               @map("issue_date") @db.Date
  dueDate         DateTime?              @map("due_date") @db.Date
  lifecycleStatus InvoiceLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  voidedAt        DateTime?              @map("voided_at") @db.Timestamptz
  voidReason      String?                @map("void_reason")
  createdBy       String?                @map("created_by") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime               @default(now()) @map("updated_at") @db.Timestamptz

  account       StudentAccount @relation(fields: [organizationId, accountId], references: [organizationId, id])
  student       Student        @relation(fields: [organizationId, studentId], references: [organizationId, id])
  createdByUser User?          @relation(fields: [createdBy], references: [id])

  studentLedgerEntries StudentLedgerEntry[]
  invoiceItems         InvoiceItem[]
  paymentAllocations   PaymentAllocation[]
  refundAllocations    RefundAllocation[]

  @@unique([organizationId, number], map: "invoices_org_number_uq")
  @@unique([organizationId, id], map: "invoices_tenant_uq")
  @@unique([organizationId, accountId, id], map: "invoices_account_uq")
  @@index([organizationId, studentId, issueDate])
  @@index([organizationId, lifecycleStatus, dueDate])
  @@map("invoices")
}

/// total SAQLANMAYDI — quantity * unit_price dan hosil qilinadi (3NF).
model InvoiceItem {
  id                       String   @id @default(uuid()) @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  invoiceId                String   @map("invoice_id") @db.Uuid
  itemCode                 String   @map("item_code") @db.VarChar
  description              String   @db.VarChar
  quantity                 Decimal  @db.Decimal(18, 4)
  unitPrice                Decimal  @map("unit_price") @db.Decimal(18, 2)
  paymentPlanInstallmentId String?  @unique @map("payment_plan_installment_id") @db.Uuid
  discountAssignmentId     String?  @map("discount_assignment_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice                Invoice                        @relation(fields: [organizationId, invoiceId], references: [organizationId, id])
  paymentPlanInstallment StudentPaymentPlanInstallment? @relation(fields: [organizationId, paymentPlanInstallmentId], references: [organizationId, id])
  discountAssignment     DiscountAssignment?            @relation(fields: [organizationId, discountAssignmentId], references: [organizationId, id])

  @@index([organizationId, invoiceId])
  @@map("invoice_items")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  accountId        String        @map("account_id") @db.Uuid
  studentId        String        @map("student_id") @db.Uuid
  cashboxId        String?       @map("cashbox_id") @db.Uuid
  branchId         String?       @map("branch_id") @db.Uuid
  amount           Decimal       @db.Decimal(18, 2)
